NODE_ENV=development
DB_PORT=5433
DB_OWNER_PASSWORD=replace-with-random-hex-owner-password
DB_APP_PASSWORD=replace-with-different-random-hex-app-password
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://barpo_app:replace-with-different-random-hex-app-password@127.0.0.1:5433/barpo
MIGRATION_DATABASE_URL=postgresql://barpo_owner:replace-with-random-hex-owner-password@127.0.0.1:5433/barpo
# Frontend origin: CORS va cookie sessiya uchun CSRF tekshiruvi shu originga bog'lanadi.
APP_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
# Reverse proxy orqasida 1 qiling (X-Forwarded-* ishonchli bo'lsa).
TRUST_PROXY=0
# Set only in your private environment. No default account is installed.
# BOOTSTRAP_LOGIN=platform.owner
# BOOTSTRAP_PASSWORD=
# BOOTSTRAP_ROLE=platform_owner
# Telegram bot (BotFather). Token faqat .env da; Gitga tushmaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=barpoai_bot
TELEGRAM_LINK_TOKEN_TTL_SECONDS=300
