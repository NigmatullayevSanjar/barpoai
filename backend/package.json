{
  "name": "@barpo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "bootstrap": "tsx src/bootstrap.ts",
    "worker": "tsx src/worker.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "tsx scripts/integration.ts",
    "docs": "tsx scripts/docs.ts",
    "check": "npm run build && npm test && npm run docs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "test:ui": "tsx scripts/ui-test.ts",
    "test:roles": "tsx scripts/role-tests.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "jszip": "^3.10.1",
    "pg": "^8.16.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
