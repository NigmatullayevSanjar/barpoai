# Serverda: cp .env.example .env && nano .env   (.env Gitga tushmaydi)
# Domen DNS A-yozuvi server IP'siga qarashi kerak; Caddy HTTPS sertifikatni o'zi oladi.
DOMAIN=app.example.uz
# Ikkalasi ham har xil bo'lsin: openssl rand -hex 24
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=barpoai_bot
TELEGRAM_LINK_TOKEN_TTL_SECONDS=300
# Zaxira nusxa: Hetzner Storage Box (bo'sh qoldirilsa faqat serverning o'zida saqlanadi)
# BACKUP_REMOTE=u123456@u123456.your-storagebox.de:barpo
